{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "MicroservicesOrchestrator": {
    "AutoStartBackendServices": true,
    "AutoStartFrontendSpa": true,
    "IdentityPort": 5081,
    "CatalogPort": 5082,
    "OrderPort": 5083,
    "WorkflowPort": 5084,
    "AnnouncementPort": 5085,
    "SpaPort": 5173
  },
  "ServiceEndpoints": {
    "GatewayUrl": "http://localhost:5080",
    "IdentityServiceUrl": "http://localhost:5081",
    "CatalogServiceUrl": "http://localhost:5082",
    "OrderServiceUrl": "http://localhost:5083",
    "WorkflowServiceUrl": "http://localhost:5084",
    "AnnouncementServiceUrl": "http://localhost:5085"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "users-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users"
        }
      },
      "roles-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "roles-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/roles"
        }
      },
      "menus-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/menus/{**catch-all}"
        }
      },
      "menus-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/menus"
        }
      },
      "organizations-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/organizations/{**catch-all}"
        }
      },
      "organizations-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/organizations"
        }
      },
      "dashboard-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/dashboard/{**catch-all}"
        }
      },
      "products-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "products-root-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products"
        }
      },
      "orders-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "orders-root-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders"
        }
      },
      "workflows-route": {
        "ClusterId": "workflow-cluster",
        "Match": {
          "Path": "/api/workflows/{**catch-all}"
        }
      },
      "workflows-root-route": {
        "ClusterId": "workflow-cluster",
        "Match": {
          "Path": "/api/workflows"
        }
      },
      "announcements-route": {
        "ClusterId": "announcement-cluster",
        "Match": {
          "Path": "/api/announcements/{**catch-all}"
        }
      },
      "announcements-root-route": {
        "ClusterId": "announcement-cluster",
        "Match": {
          "Path": "/api/announcements"
        }
      },
      "announcements-hub-route": {
        "ClusterId": "announcement-cluster",
        "Match": {
          "Path": "/hubs/announcements/{**catch-all}"
        }
      },
      "announcements-hub-root-route": {
        "ClusterId": "announcement-cluster",
        "Match": {
          "Path": "/hubs/announcements"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5081"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5082"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5083"
          }
        }
      },
      "workflow-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5084"
          }
        }
      },
      "announcement-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5085"
          }
        }
      }
    }
  }
}
