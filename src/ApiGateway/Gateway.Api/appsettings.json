{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "MicroservicesOrchestrator": {
    "AutoStartBackendServices": true,
    "AutoStartFrontendSpa": true,
    "IdentityPort": 5081,
    "CatalogPort": 5082,
    "OrderPort": 5083,
    "SpaPort": 5173
  },
  "ServiceEndpoints": {
    "GatewayUrl": "http://localhost:5080",
    "IdentityServiceUrl": "http://localhost:5081",
    "CatalogServiceUrl": "http://localhost:5082",
    "OrderServiceUrl": "http://localhost:5083"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "users-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/users"
        }
      },
      "roles-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/roles/{**catch-all}"
        }
      },
      "roles-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/roles"
        }
      },
      "menus-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/menus/{**catch-all}"
        }
      },
      "menus-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/menus"
        }
      },
      "dashboard-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/dashboard/{**catch-all}"
        }
      },
      "products-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "products-root-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/api/products"
        }
      },
      "orders-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "orders-root-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/orders"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5081"
          }
        }
      },
      "catalog-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5082"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5083"
          }
        }
      }
    }
  }
}
