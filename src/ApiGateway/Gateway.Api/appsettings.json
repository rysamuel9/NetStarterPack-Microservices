{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5080",
  "MicroservicesOrchestrator": {
    "AutoStartBackendServices": true,
    "AutoStartFrontendSpa": true,
    "IdentityPort": 5081,
    "CatalogPort": 5082,
    "OrderPort": 5083,
    "WorkflowPort": 5084,
    "AnnouncementPort": 5085,
    "MasterDataPort": 5086,
    "SpaPort": 5173
  },
  "ServiceEndpoints": {
    "GatewayUrl": "http://localhost:5080",
    "IdentityServiceUrl": "http://localhost:5081",
    "CatalogServiceUrl": "http://localhost:5082",
    "OrderServiceUrl": "http://localhost:5083",
    "WorkflowServiceUrl": "http://localhost:5084",
    "AnnouncementServiceUrl": "http://localhost:5085",
    "MasterDataServiceUrl": "http://localhost:5086"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://localhost:3000"
    ]
  },
  "HttpResilienceSettings": {
    "Enabled": true,
    "MaxRetryAttempts": 2,
    "RetryBaseDelayMs": 200,
    "AttemptTimeoutSeconds": 3,
    "TotalRequestTimeoutSeconds": 8,
    "CircuitBreakerFailureRatio": 0.5,
    "CircuitBreakerMinimumThroughput": 5,
    "CircuitBreakerSamplingDurationSeconds": 30,
    "CircuitBreakerBreakDurationSeconds": 15
  },
  "ReverseProxy": {
    "Routes": {
      "auth-v-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v{version}/auth/{**catch-all}"
        }
      },
      "users-v-route": {
