<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\BuildingBlocks.Core\BuildingBlocks.Core.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\BuildingBlocks.Security\BuildingBlocks.Security.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Hanya untuk Debug (F5 lokal): pastikan Visual Studio otomatis build seluruh microservice sebelum Auto-Orchestrator menjalankannya.
       Dikecualikan saat Release/Publish agar tidak memicu konflik NETSDK1152 (duplicate appsettings.json). -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\..\Services\Identity\Identity.Api\Identity.Api.csproj" ReferenceOutputAssembly="false" Private="false" ExcludeAssets="all" />
    <ProjectReference Include="..\..\Services\Catalog\Catalog.Api\Catalog.Api.csproj" ReferenceOutputAssembly="false" Private="false" ExcludeAssets="all" />
    <ProjectReference Include="..\..\Services\Order\Order.Api\Order.Api.csproj" ReferenceOutputAssembly="false" Private="false" ExcludeAssets="all" />
    <ProjectReference Include="..\..\Services\Workflow\Workflow.Api\Workflow.Api.csproj" ReferenceOutputAssembly="false" Private="false" ExcludeAssets="all" />
    <ProjectReference Include="..\..\Services\Announcement\Announcement.Api\Announcement.Api.csproj" ReferenceOutputAssembly="false" Private="false" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

</Project>
