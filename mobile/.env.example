# URL Gateway.Api (:5080)
# - Untuk HP fisik (Samsung/Android/iOS) di Wi-Fi yang sama: ganti dengan IP LAN PC (cek lewat `ipconfig`), contoh:
#   EXPO_PUBLIC_API_URL=http://192.168.1.15:5080
# - Untuk Android Emulator: http://10.0.2.2:5080
# - Untuk USB kabel dengan `adb reverse tcp:5080 tcp:5080`: http://localhost:5080
EXPO_PUBLIC_API_URL=http://localhost:5080
